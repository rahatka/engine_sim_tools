import "engine_sim.mr"

units units()

// Москвич-400
public node veh {
    alias output __out: vehicle;

    label car_mass(1000) // 845 empty; 845 + 270 full

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.45, // ?
        cross_sectional_area: (1400 * units.mm) * (1555 * units.mm),
        diff_ratio: 5.14,
        tire_radius: (660.4 / 2) * units.mm, // 5.00 x 16
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// Москвич-400
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 70 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.56)
        .add_gear(1.73)
        .add_gear(1.00);
}

