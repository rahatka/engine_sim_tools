import "engine_sim.mr"

units units()

// 1935 P4
public node veh {
    alias output __out: vehicle;
    label car_mass(820.0) // 752 curb
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.45, // ?
        cross_sectional_area: (1425 * units.mm) * (1640 * units.mm),
        diff_ratio: 5.57,
        tire_radius: (738.0 / 2) * units.mm, // 4.25x17
        rolling_resistance: 0.05 * car_mass * 9.81
        )
}

// 1935 P4
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 150 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.56)
        .add_gear(1.73)
        .add_gear(1.00);
}

