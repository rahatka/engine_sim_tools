import "engine_sim.mr"

units units()

// 1935 Packard One Twenty B
public node veh {
    alias output __out: vehicle;

    label car_mass(1833) // 1632.933 empty Sedan Touring

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.48,
        cross_sectional_area: (1828.8 * units.mm) * (1714.5 * units.mm),
        diff_ratio: 4.09,
        tire_radius: (786.0 / 2) * units.mm, // 7.0 x 16
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 1935 Packard One Twenty B
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 350 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.425)
        .add_gear(1.528)
        .add_gear(1.000);
}

