import "engine_sim.mr"

units units()

// 1936 Zephyr
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1520 * units.kg,
        drag_coefficient: 0.45,
        cross_sectional_area: (1854 * units.mm) * (1753 * units.mm),
        diff_ratio: 3.0,
        tire_radius: (673.0 / 2) * units.mm,
        rolling_resistance: 20
        )
}

// 1936 Zephyr
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 300 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.86)
        .add_gear(1.68)
        .add_gear(1.0);
}

