import "engine_sim.mr"

units units()

// Универсал-1
public node veh {
    alias output __out: vehicle;
    label car_mass(2050.0)
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.5,
        cross_sectional_area: (1700 * units.mm) * (1600 * units.mm), // ?
        diff_ratio: 4.85 * 6.15,
        tire_radius: (1017.0 / 2) * units.mm,
        rolling_resistance: 0.05 * car_mass * 9.81
        )
}

// Универсал-1
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 150 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.25)
        .add_gear(1.60)
        .add_gear(1.08);
}

