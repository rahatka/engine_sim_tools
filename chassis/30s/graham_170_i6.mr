import "engine_sim.mr"

units units()

// 1934 Graham 6-74
public node veh {
    alias output __out: vehicle;
    label car_mass(1270) // 2700 lbs shipping
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.48,
        cross_sectional_area: (1739.9 * units.mm) * (1714.5 * units.mm),
        diff_ratio: 4.54,
        tire_radius: (724.0 / 2) * units.mm, // 17 x 5.25
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 1934 Graham 6-74
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 250 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.832)
        .add_gear(1.661)
        .add_gear(1.000);
}

