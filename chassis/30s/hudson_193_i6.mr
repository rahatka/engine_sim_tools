import "engine_sim.mr"

units units()

// 1932 Greater Essex Super Six
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1447.0 * units.kg, // 1247 sedan ??
        drag_coefficient: 0.48,
        cross_sectional_area: (1920 * units.mm) * (1800 * units.mm), // ?
        diff_ratio: 4.63, // 5.4
        tire_radius: (739.0 / 2) * units.mm, // 18 x 5.25
        rolling_resistance: 20
        )
}

// 1932 Greater Essex Super Six
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 250 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.44)
        .add_gear(1.62)
        .add_gear(1.00);
}

