import "engine_sim.mr"

units units()

// 1932 Hudson Eight
public node veh {
    alias output __out: vehicle;

    label car_mass(1683) // 1483 empty

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.42,
        cross_sectional_area: (1866.9 * units.mm) * (1700 * units.mm), // ???
        diff_ratio: 4.63,
        tire_radius: (831.3 / 2) * units.mm, // 17 x 6.0
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 1932 Hudson Eight
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 350 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.44)
        .add_gear(1.62)
        .add_gear(1.00);
}

