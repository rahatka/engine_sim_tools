import "engine_sim.mr"

units units()

// Marmon Sixteen
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 2540  * units.kg,
        drag_coefficient: 0.45,
        cross_sectional_area: (1800 * units.mm) * (1700 * units.mm),
        diff_ratio: 3.78,
        tire_radius: (812.8 / 2) * units.mm,
        rolling_resistance: 20
        )
}

// Marmon Sixteen
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 600 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.08)
        .add_gear(1.57)
        .add_gear(1.0);
}

