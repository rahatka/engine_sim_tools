import "engine_sim.mr"

units units()

// 1935 P4
public node veh {
    alias output __out: vehicle;
    label car_mass(920.0) // 865 curb
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.45, // ?
        cross_sectional_area: (1430 * units.mm) * (1540 * units.mm),
        diff_ratio: 5.14,
        tire_radius: (682.0 / 2) * units.mm, // 5.00x16
        rolling_resistance: 0.05 * car_mass * 9.81
        )
}

// 1935 P4
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 150 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.91)
        .add_gear(2.47)
        .add_gear(1.49)
        .add_gear(1.00);
}

