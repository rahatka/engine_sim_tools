import "engine_sim.mr"

units units()

// Ford A
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1027 * units.kg,
        drag_coefficient: 0.65,
        cross_sectional_area: (1702 * units.mm) * (1728 * units.mm),
        diff_ratio: 3.78, // A-4209-B
        tire_radius: (807.0 / 2) * units.mm, // 6.00x19
        rolling_resistance: 20
        )
}

// Ford A
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 300 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 10 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.12)
        .add_gear(1.85)
        .add_gear(1.0);
}

