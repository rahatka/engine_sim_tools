import "engine_sim.mr"

units units()

// 
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 2390 * units.kg,
        drag_coefficient: 0.43,
        cross_sectional_area: (1920 * units.mm) * (1200 * units.mm),
        diff_ratio: 3.8,
        tire_radius: (650.0 / 2) * units.mm,
        rolling_resistance: 20
        )
}

public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 800 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(2.485)
        .add_gear(1.397)
        .add_gear(1.0);
}

