import "engine_sim.mr"

units units()

// Opel-Blitz 3,6-36S
public node veh {
    alias output __out: vehicle;
    label car_mass(5800) // 5430 empty
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.7, // ?
        cross_sectional_area: (2150 * units.mm) * (2850 * units.mm),
        diff_ratio: 6.83,
        tire_radius: (803.0 / 2) * units.mm,
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// Opel-Blitz 3,6-36S
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 375 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(7.84)
        .add_gear(4.82)
        .add_gear(2.71)
        .add_gear(1.58)
        .add_gear(1.00);
}

