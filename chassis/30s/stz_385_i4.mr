import "engine_sim.mr"

units units()

// СТЗ-15/30
public node veh {
    alias output __out: vehicle;

    label car_mass(3100) // 3000 empty

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.63,
        cross_sectional_area: (2300 * units.mm) * (2750 * units.mm),
        diff_ratio: 22.19, // 50/13 x 75/13
        tire_radius: (1270.0 / 2) * units.mm,
        rolling_resistance: 0.05 * car_mass * 9.81
        )
}

// СТЗ-15/30
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 350 * units.Nm,
            max_clutch_flex: 12 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.20) // 48/15
        .add_gear(2.50) // 45/18
        .add_gear(1.52); // 38/25
}

