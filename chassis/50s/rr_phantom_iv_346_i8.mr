import "engine_sim.mr"

units units()

// RR Phantom IV
public node veh {
    alias output __out: vehicle;

    label car_mass(2100) // 1921 empty

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.42,
        cross_sectional_area: (1955.0 * units.mm) * (1879 * units.mm),
        diff_ratio: 4.25,
        tire_radius: (815.34 / 2) * units.mm, // 8.00 x 17 Dunlop Fort C
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// RR Phantom IV
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 500 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        // manual
        .add_gear(2.98)
        .add_gear(2.02)
        .add_gear(1.34)
        .add_gear(1.00);

        // automatic
        // .add_gear(3.82)
        // .add_gear(2.63)
        // .add_gear(1.45)
        // .add_gear(1.00);
}

