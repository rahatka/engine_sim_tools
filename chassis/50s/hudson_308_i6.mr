import "engine_sim.mr"

units units()

// Hornet
public node veh {
    alias output __out: vehicle;
    label car_mass(1800) // curb 1723
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.4,
        cross_sectional_area: (1972 * units.mm) * (1534 * units.mm),
        diff_ratio: 3.07,
        tire_radius: (710.692 / 2) * units.mm, // 7.10 x 15 or 7.60 x 15
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// Hornet Auto
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 420 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.8195)
        .add_gear(2.6341)
        .add_gear(1.45)
        .add_gear(1.0);
}

