import "engine_sim.mr"

units units()

// GAZ-21
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1460 * units.kg,
        drag_coefficient: 0.497,
        cross_sectional_area: (1800 * units.mm) * (1620 * units.mm),
        diff_ratio: 4.55,
        tire_radius: (715.0 / 2) * units.mm,
        rolling_resistance: 20
        )
}

// GAZ-21
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 175 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 10 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.12)
        .add_gear(1.77)
        .add_gear(1.0);
}

