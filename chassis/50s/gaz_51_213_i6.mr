import "engine_sim.mr"

units units()

// ПАЗ-651
public node veh {
    alias output __out: vehicle;

    label car_mass(3750 + 2500) // 3750 empty + 3185 max load

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.53,
        cross_sectional_area: (2400 * units.mm) * (2870 * units.mm),
        diff_ratio: 6.67,
        tire_radius: (927.1 / 2) * units.mm, // 8.25x20
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// ПАЗ-651
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 300 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(6.40)
        .add_gear(3.09)
        .add_gear(1.69)
        .add_gear(1.0);
}

