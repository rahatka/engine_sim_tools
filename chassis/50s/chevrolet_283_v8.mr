import "engine_sim.mr"

units units()

// 1957 Corvette
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1327 * units.kg,
        drag_coefficient: 0.37,
        cross_sectional_area: (1790.7 * units.mm) * (1320.8 * units.mm),
        diff_ratio: 3.70, // 3.70:1, 4.11:1 and 4.56:1.
        tire_radius: (715.0 / 2) * units.mm, // 6.70-15
        rolling_resistance: 20
        )
}

// 1957 Corvette
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 500 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.20)
        .add_gear(1.66)
        .add_gear(1.31)
        .add_gear(1.00);
}

