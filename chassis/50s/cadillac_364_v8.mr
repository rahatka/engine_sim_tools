import "engine_sim.mr"

units units()

// 1956 Cadillac Series 62 Sedan — 365 V8
public node veh {
    alias output __out: vehicle;

    // Estimated curb weight: approximately 4610 lb / 2090 kg
    label car_mass(2090.0)

    vehicle vehicle(
        mass: car_mass * units.kg,

        // Estimated aerodynamic value for the large,
        // rounded 1956 Cadillac body
        drag_coefficient: 0.46,

        // Overall width: 80.0 in / 2032 mm
        // Overall height: 62.0 in / 1575 mm
        cross_sectional_area:
            (2032 * units.mm) * (1575 * units.mm),

        // Standard Series 62 rear axle.
        // Optional performance axle: 3.36
        diff_ratio: 3.07,

        // Standard 8.00x15 bias-ply tyre
        // Approximate diameter: 739 mm
        tire_radius: (739.0 / 2) * units.mm,

        // Period bias-ply tyres
        rolling_resistance: 0.015 * car_mass * 9.81
    )
}


// 1956 Cadillac controlled-coupling Hydra-Matic
public node trn {
    alias output __out:
        transmission(
            // Factory engine torque: 400 lb-ft / 542 Nm
            max_clutch_torque: 550 * units.Nm,

            // Approximation of the Hydra-Matic fluid coupling
            max_clutch_flex: 12 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 18 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.9666)
        .add_gear(2.5532)
        .add_gear(1.5536)
        .add_gear(1.0000);
}

