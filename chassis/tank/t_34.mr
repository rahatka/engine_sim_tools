import "engine_sim.mr"

units units()

// T-34
public node veh {
    alias output __out: vehicle;

    label car_mass(30900) // T-34/76

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.6,
        cross_sectional_area: (2460 * units.mm) * (2374 * units.mm),
        diff_ratio: 5.7, // 1.859 bevel
        tire_radius: (634.0 / 2) * units.mm,
        rolling_resistance: 0.07 * car_mass * 9.81
        )
}

// T-34
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 3500 * units.Nm,
            max_clutch_flex: 8 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 200 * units.Nm / units.deg,
            clutch_damping: 2.5,
            simulate_flex: true
        )
        .add_gear(5.570)
        .add_gear(2.600)
        .add_gear(1.855)
        .add_gear(1.215)
        .add_gear(0.756);
}
