import "engine_sim.mr"

units units()

// ЗиС-154
public node veh {
    alias output __out: vehicle;

    label car_mass(11000) // 8000 empty; 12340 full

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.63,
        cross_sectional_area: (2500 * units.mm) * (2940 * units.mm),
        diff_ratio: 6.0,
        tire_radius: (1068.0 / 2) * units.mm, // 10.0R20; 1092 11.0R20
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// ЗиС-154
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 650 * units.Nm,
            max_clutch_flex: 0 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 0 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: false
        )
        .add_gear(1.0);
}
