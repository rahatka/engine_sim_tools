import "engine_sim.mr"

units units()

// ГАЗ 12 ЗИМ
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1800  * units.kg,
        drag_coefficient: 0.45,
        cross_sectional_area: (1900 * units.mm) * (1660 * units.mm),
        diff_ratio: 4.55,
        tire_radius: (736.6 / 2) * units.mm,
        rolling_resistance: 20
        )
}

// ГАЗ 12 ЗИМ
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 300 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.115)
        .add_gear(1.772)
        .add_gear(1.0);
}

