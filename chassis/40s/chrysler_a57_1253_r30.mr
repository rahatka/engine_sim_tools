import "engine_sim.mr"

units units()

// T-34
public node veh {
    alias output __out: vehicle;

    label car_mass(41000) // Churchill VII & VIII

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.8,
        cross_sectional_area: (3050 * units.mm) * (2440 * units.mm),
        diff_ratio: 15.02,
        tire_radius: (741.0 / 2) * units.mm,
        rolling_resistance: 0.07 * car_mass * 9.81
        )
}

// Churchill
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 1500 * units.Nm,
            max_clutch_flex: 8 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 200 * units.Nm / units.deg,
            clutch_damping: 2.5,
            simulate_flex: true
        )
        .add_gear(8.003)
        .add_gear(2.818)
        .add_gear(1.582)
        .add_gear(1.000);
}

