import "engine_sim.mr"

units units()

// 356
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 876  * units.kg,
        drag_coefficient: 0.296,
        cross_sectional_area: (1660  * units.mm) * (1320 * units.mm),
        diff_ratio: 4.428,
        tire_radius: (655.0 / 2) * units.mm, // 5.60×15
        rolling_resistance: 20
        )
}

// 356
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 120 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.18)
        .add_gear(1.76)
        .add_gear(1.13)
        .add_gear(0.81);
}

