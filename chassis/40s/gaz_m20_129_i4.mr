import "engine_sim.mr"

units units()

// ГАЗ М-20
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1360 * units.kg,
        drag_coefficient: 0.34, // 0.31 ?
        cross_sectional_area: (1695 * units.mm) * (1640 * units.mm),
        diff_ratio: 5.125,
        tire_radius: (711.2 / 2) * units.mm, // 6.00 x 16
        rolling_resistance: 20
        )
}

// ГАЗ М-20
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 150 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(2.82)
        .add_gear(1.604)
        .add_gear(1.0);
}

