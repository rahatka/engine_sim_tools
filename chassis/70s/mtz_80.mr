import "engine_sim.mr"

units units()

// МТЗ-80
public node veh {
    alias output __out: vehicle;

    label car_mass(3370) // 3370 empty

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.63,
        cross_sectional_area: (1970 * units.mm) * (2470 * units.mm),
        diff_ratio: 3.42 * 5.308, // 1.36 reducer
        tire_radius: (1570.0 / 2) * units.mm, // 15.5R38
        rolling_resistance: 0.025 * car_mass * 9.81
        )
}

// МТЗ-80
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 350 * units.Nm,
            max_clutch_flex: 12 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(13.342)
        .add_gear(7.835)
        .add_gear(4.607)
        .add_gear(3.750)
        .add_gear(3.165)
        .add_gear(2.705)
        .add_gear(2.202)
        .add_gear(1.859)
        .add_gear(1.000);
}
