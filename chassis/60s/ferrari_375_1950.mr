import "engine_sim.mr"

units units()

// 1950 Ferrari 375
public node veh {
    alias output __out: vehicle;
    label car_mass(1054.1487) // loaded
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.45,
        cross_sectional_area: 10.75 * (units.foot * units.foot),
        diff_ratio: 3.9,
        tire_radius: (850.9 / 2) * units.mm, // 7.5 x 17
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 1950 Ferrari 375
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 500 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(2.359)
        .add_gear(1.436)
        .add_gear(1.167)
        .add_gear(1.000);
}

