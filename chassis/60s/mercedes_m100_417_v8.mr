import "engine_sim.mr"

units units()

// 450 SEL 6.9
public node veh {
    alias output __out: vehicle;

    label car_mass(2100) // 1985

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.37,
        cross_sectional_area: (1870 * units.mm) * (1410 * units.mm),
        diff_ratio: 2.65,
        tire_radius: (658.0 / 2) * units.mm, // 215/70VR14
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 450 SEL 6.9
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 600 * units.Nm,
            max_clutch_flex: 15 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.31)
        .add_gear(1.46)
        .add_gear(1.00);
}

