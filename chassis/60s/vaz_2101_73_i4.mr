import "engine_sim.mr"

units units()

// ВАЗ-2101
public node veh {
    alias output __out: vehicle;

    label car_mass(1100) // 955 empty; 1355 full

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.52,
        cross_sectional_area: (1611 * units.mm) * (1440 * units.mm),
        diff_ratio: 4.3,
        tire_radius: (600.0 / 2) * units.mm, // 6,15-13
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// ВАЗ-2101
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 150 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.753)
        .add_gear(2.303)
        .add_gear(1.493)
        .add_gear(1.000);
}

