import "engine_sim.mr"

units units()

// ЛАЗ-699А
public node veh {
    alias output __out: vehicle;

    label car_mass(11500) // 8829 12931

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.48,
        cross_sectional_area: (2500 * units.mm) * (3050 * units.mm),
        diff_ratio: 7.74,
        tire_radius: (1016.0 / 2) * units.mm, // 10.0 x 20
        rolling_resistance: 0.012 * car_mass * 9.81,
        max_brake_force: 25000 * units.Nm
        )
}

// ЛАЗ-699А
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 500 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(6.17)
        .add_gear(3.40)
        .add_gear(1.79)
        .add_gear(1.00)
        .add_gear(0.78);
}

