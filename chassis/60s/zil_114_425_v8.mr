import "engine_sim.mr"

units units()

// ЗиЛ-114
public node veh {
    alias output __out: vehicle;

    label car_mass(3300) // 3080 / 3605

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.42,
        cross_sectional_area: (2068 * units.mm) * (1500 * units.mm),
        diff_ratio: 3.54,
        tire_radius: (855.98 / 2) * units.mm, // 9.35 x 15
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// ЗиЛ-114
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 620 * units.Nm,
            max_clutch_flex: 5 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(1.72)
        .add_gear(1.00);
}

