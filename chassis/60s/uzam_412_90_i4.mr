import "engine_sim.mr"

units units()

// M-412
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1045 * units.kg,
        drag_coefficient: 0.41,
        cross_sectional_area: (1550 * units.mm) * (1480 * units.mm),
        diff_ratio: 4.22,
        tire_radius: (610.0 / 2) * units.mm, // P175/80R13
        rolling_resistance: 20
        )
}

// M-412
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 150 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 10 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.49)
        .add_gear(2.04)
        .add_gear(1.33)
        .add_gear(1.0);
}

