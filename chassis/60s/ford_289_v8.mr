import "engine_sim.mr"

units units()

// Mk I
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: (953 + 100) * units.kg,
        drag_coefficient: 0.39,
        cross_sectional_area: (1778 * units.mm) * (1029 * units.mm),
        diff_ratio: 3.55,
        tire_radius: (881.38 / 2) * units.mm, // 185/70 R14
        rolling_resistance: 20
        )
}

// Mk I
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 500 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 10 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.50)
        .add_gear(1.70)
        .add_gear(1.29)
        .add_gear(1.00);
}

