import "engine_sim.mr"

units units()

// ГАЗ-14
public node veh {
    alias output __out: vehicle;

    label car_mass(2900.0) // 2615 3175

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.39,
        cross_sectional_area: (2020 * units.mm) * (1580 * units.mm),
        diff_ratio: 3.58,
        tire_radius: (855.98 / 2) * units.mm, // 9.35 x 15
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// ГАЗ-14
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 450 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(2.64)
        .add_gear(1.55)
        .add_gear(1.00);
}

