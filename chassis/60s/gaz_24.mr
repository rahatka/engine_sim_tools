import "engine_sim.mr"

units units()

// ГАЗ-24
public node veh {
    alias output __out: vehicle;

    label car_mass(1600) // 1420 empty; 1820 full

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.45,
        cross_sectional_area: (1800 * units.mm) * (1450 * units.mm),
        diff_ratio: 4.1,
        tire_radius: (668.0 / 2) * units.mm, // 7,35-14
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// ГАЗ-24
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 175 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 10 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.50)
        .add_gear(2.26)
        .add_gear(1.45)
        .add_gear(1.00);
}

