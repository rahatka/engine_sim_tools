import "engine_sim.mr"

units units()

// 1925 Hupp E-1
public node veh {
    alias output __out: vehicle;

    label car_mass(1599 + 100)

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.46,
        cross_sectional_area: (1752.6 * units.mm) * (1778.0 * units.mm), // ?
        diff_ratio: 4.64,
        tire_radius: (848.36 / 2) * units.mm, // 6.00-21
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 1925 Hupp E-1
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 250 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.11)
        .add_gear(1.69)
        .add_gear(1.00);
}

