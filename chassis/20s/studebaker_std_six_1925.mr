import "engine_sim.mr"

units units()

// 1925 Studebaker Std Six
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1480  * units.kg,
        drag_coefficient: 0.48,
        cross_sectional_area: (1920 * units.mm) * (1200 * units.mm), // ?
        diff_ratio: 4.6, // 4.18
        tire_radius: (810.26 / 2) * units.mm, // 31 x 5.25
        rolling_resistance: 20
        )
}

// 1925 Studebaker Std Six
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 250 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.32)
        .add_gear(1.83)
        .add_gear(1.00);
}

