import "engine_sim.mr"

units units()

// 1927 Reo Fl Cl
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1678.292  * units.kg, // sedan
        drag_coefficient: 0.48,
        cross_sectional_area: (1920 * units.mm) * (1200 * units.mm), // ?
        diff_ratio: 4.58, // 4.25 for roadster
        tire_radius: (781.0 / 2) * units.mm, // 30x6.20
        rolling_resistance: 20
        )
}

// 1927 Reo Fl Cl
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 220 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.26)
        .add_gear(1.73)
        .add_gear(1.00);
}

