import "engine_sim.mr"

units units()

// 1929 Essex Super Six
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass: 1445 * units.kg, // 1245 sedan
        drag_coefficient: 0.48,
        cross_sectional_area: (1920 * units.mm) * (1800 * units.mm), // ?
        diff_ratio: 5.09, // 5.6
        tire_radius: (762.0 / 2) * units.mm, // 30 x 5.0
        rolling_resistance: 20
        )
}

// 1929 Essex Super Six
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 250 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.244)
        .add_gear(1.961)
        .add_gear(1.000);
}

