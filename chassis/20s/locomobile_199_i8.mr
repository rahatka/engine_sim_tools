import "engine_sim.mr"

units units()

// Locomobile Jr 8
public node veh {
    alias output __out: vehicle;

    label car_mass(1642) // 1542 empty

    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.42,
        cross_sectional_area: (1700.0 * units.mm) * (1800 * units.mm), // ?
        diff_ratio: 4.78,
        tire_radius: (815.0 / 2) * units.mm, // 30 x 5.77
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// Locomobile Jr 8
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 200 * units.Nm,
            max_clutch_flex: 20 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(3.32)
        .add_gear(1.77)
        .add_gear(1.00);
}

