import "engine_sim.mr"

units units()

// Cadillac 341
public node veh {
    alias output __out: vehicle;
    vehicle vehicle(
        mass:  1989 * units.kg,
        drag_coefficient: 0.48,
        cross_sectional_area: (1920 * units.mm) * (1200 * units.mm),
        diff_ratio: 4.39, // 4.75 5.08
        tire_radius: (866.0 / 2) * units.mm, // 7.00x20
        rolling_resistance: 20
        )
}

// Cadillac 341
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 400 * units.Nm,
            max_clutch_flex: 10 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 2.0,
            simulate_flex: true
        )
        .add_gear(3.125)
        .add_gear(1.705)
        .add_gear(1.000);
}

