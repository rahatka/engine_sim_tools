import "engine_sim.mr"

units units()

// 1928 W 06
public node veh {
    alias output __out: vehicle;
    label car_mass(2100) // tourer: 2000 kg; cabriolet: 2100 kg
    vehicle vehicle(
        mass: car_mass * units.kg,
        drag_coefficient: 0.43, // ?
        cross_sectional_area: (1700 * units.mm) * (1750 * units.mm),
        diff_ratio: 2.76, // 2.76; 2.50 or 3.09
        tire_radius: (870.0 / 2) * units.mm, // 650/700 x 20
        rolling_resistance: 0.012 * car_mass * 9.81
        )
}

// 1928 W 06
public node trn {
    alias output __out:
        transmission(
            max_clutch_torque: 550 * units.Nm,
            max_clutch_flex: 30 * units.deg,
            limit_clutch_flex: true,
            clutch_stiffness: 20 * units.Nm / units.deg,
            clutch_damping: 1.0,
            simulate_flex: true
        )
        .add_gear(2.75)
        .add_gear(1.55)
        .add_gear(1.12)
        .add_gear(1.00);
}

