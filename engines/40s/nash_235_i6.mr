import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(85.725) // 3 3/8
label stroke(111.125) // 4 3/8
label compression_ratio(6.0)
label con_rod(222.25) // 8 3/4
label compression_height(98.425 / 2 * units.mm) // 3 7/8 l
label intake_valve_diameter(44.45) // 1 3/4 ; .3725 stem
label exhaust_valve_diameter(40.48125) // 1 19/32 ; .3725 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(3500.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// Nash 1940
label IVL(8.73125) // 11/32
label EVL(8.73125) // 11/32
label IVO(24.5 * units.deg) //BTDC
label IVC(70.5 * units.deg) //ABDC
label EVO(49.5 * units.deg) //BBDC
label EVC(5.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(1027.67) // 36 1/4
label piston_mass(545.728) // 19 1/4
label crank_mass(20.0) // ?
label flywheel_mass(4.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

