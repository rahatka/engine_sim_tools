import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(57.404) // 2.26
label stroke(79.375) // 3 1/8
label compression_ratio(7.4)
label con_rod(146.05) // 5 3/4
label compression_height(52.9082 / 2 * units.mm) // 2.083 l
label intake_valve_diameter(28.575) // 1 1/8
label exhaust_valve_diameter(26.19375) // 1 1/32
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(4.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)

label redline(4500.0) // RPM

// Bantam
label IVL(6.5278) // .257
label EVL(6.5278) // .257
label IVO(19.0 * units.deg) //BTDC
label IVC(50.0 * units.deg) //ABDC
label EVO(57.0 * units.deg) //BBDC
label EVC(12.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(145.29131) // 5.125
label con_rod_mass(311.845) // 11
label crank_mass(8.0) // ? kg
label flywheel_mass(2.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s3: 1;
    output s4: 2;
    output s2: 3;
}

