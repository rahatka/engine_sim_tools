import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(77.7875) // 3 1/16
label stroke(107.95) // 4 1/4
label compression_ratio(6.0) // 6.5 opt
label con_rod(203.2) // 8
label compression_height(95.25 / 2 * units.mm) // 3 3/4 length
label intake_valve_diameter(35.7188) // 1 13/32 ; 11/32 stem
label exhaust_valve_diameter(32.5437) // 1 9/32 ; 11/32 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(8.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

label redline(3800.0) // RPM

// Stud 250
label IVL(8.73125) // 11/32
label EVL(8.73125) // 11/32
label IVO(15.0 * units.deg) //BTDC
label IVC(49.0 * units.deg) //ABDC
label EVO(54.0 * units.deg) //BBDC
label EVC(10.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(907.185) // 32
label piston_mass(385.5535) // 13.6
label crank_mass(25.0) // kg ?
label flywheel_mass(7.0) // kg

label exhaust_delay_coeff(1.5)

// standard
public node variant_0 {
    output s1: 0;
    output s6: 1;
    output s2: 2;
    output s5: 3;
    output s8: 4;
    output s3: 5;
    output s7: 6;
    output s4: 7;
}

