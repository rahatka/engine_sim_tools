import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(87.3125) // 3 7/16
label stroke(104.775) // 4 1/8
label compression_ratio(6.1) // 5.61 opt
label con_rod(198.4375) // 7 13/16
label compression_height(102.3945 / 2 * units.mm) // 4 1/32 L
label intake_valve_diameter(39.6875) // 1 9/16 ; .342
label exhaust_valve_diameter(36.1156) // 1 27/64 ; .3414
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)

label redline(3500.0) // RPM

// 1941 
label IVL(7.6962) // .303
label EVL(7.5692) // .298
label IVO(5.0 * units.deg) //BTDC
label IVC(45.0 * units.deg) //ABDC
label EVO(45.0 * units.deg) //BBDC
label EVC(5.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(453.592) // 17.44
label con_rod_mass(822.136) // 28
label crank_mass(12.0) // ? kg
label flywheel_mass(3.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

