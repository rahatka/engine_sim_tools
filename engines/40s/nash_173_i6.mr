import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(79.375) // 3 1/8
label stroke(95.25) // 3 3/4
label compression_ratio(6.7)
label con_rod(168.275) // 6 5/8
label compression_height(85.725 / 2 * units.mm) // 3 3/8 l
label intake_valve_diameter(37.30625) // 1 15/32 ; 1 5/16 port ; .341 stem
label exhaust_valve_diameter(32.54375) // 1 9/32 ; 1 1/8 port ; .341 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(4000.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// 1950 Nash
label IVL(7.62) // .300
label EVL(7.62) // .300
label IVO(6.0 * units.deg) //BTDC
label IVC(50.0 * units.deg) //ABDC
label EVO(46.0 * units.deg) //BBDC
label EVC(10.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(802.2915) // 22.25
label piston_mass(717.2429) // 13.75
label crank_mass(20.0) // ?
label flywheel_mass(4.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

