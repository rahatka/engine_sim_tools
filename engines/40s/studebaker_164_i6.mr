import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(76.2) // 3
label stroke(98.425) // 3 7/8
label compression_ratio(6.5)
label con_rod(163.5125) // 6 7/16
label compression_height(66.675 / 2 * units.mm) // 2 5/8 len
label intake_valve_diameter(34.13135) // 1 11/32 ; .31 stem
label exhaust_valve_diameter(32.54375) // 1 9/32 ; .31 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(4400.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// Stud 164
label IVL(7.9375) // 5/16
label EVL(7.9375) // 5/16
label IVO(15.0 * units.deg) //BTDC
label IVC(49.0 * units.deg) //ABDC
label EVO(54.0 * units.deg) //BBDC
label EVC(10.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(580.5982) // 1.28 lb
label piston_mass(240.404) // .53 lb
label crank_mass(15.0) // ?
label flywheel_mass(5.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

