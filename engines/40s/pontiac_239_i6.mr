import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(90.4875) // 3 9/16
label stroke(101.6) // 4
label compression_ratio(6.5) // 7.5 opt
label con_rod(192.087) // 7 9/16
label compression_height(91.2812 / 2 * units.mm) // 3 19/32 l
label intake_valve_diameter(40.4812) // 1 19/32 ; .310 stem
label exhaust_valve_diameter(37.3062) // 1 15/32 ; .310 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(3500.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// 1941 pontiac
label IVL(7.54062) // 19/64
label EVL(7.54062) // 19/64
label IVO(5.0 * units.deg) //BTDC
label IVC(39.0 * units.deg) //ABDC
label EVO(45.0 * units.deg) //BBDC
label EVC(5.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(1047.8) // 2.31 lbs
label piston_mass(765.437) // 27
label crank_mass(20.0) // ?
label flywheel_mass(4.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

