    "max_power_rpm": 7600.0,
    "max_torque_rpm": 6250.0,
    "port_to_valve_area": 0.81,
    "power_factor": 1.33,
    "primary_area_coeff": 1.1,
    "resolution": 32,
    "smoothness": 2.0,
    "valve_to_stem_dia": 4.8
  },
