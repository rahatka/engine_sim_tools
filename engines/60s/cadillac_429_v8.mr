import "engine_sim.mr"
import "../../fuel/50.mr"

units units()
constants constants()

label bore(104.902) // 4.13
label stroke(101.6) // 4
label compression_ratio(10.5)
label con_rod(165.1) // 6 1/2
label compression_height(50.8 * units.mm) // 2
label intake_valve_diameter(47.625) // 1 7/8 ; stem .341
label exhaust_valve_diameter(38.1) // 1 1/2 ; stem .341
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(5000.0) // RPM

label cyl(8.0)
label row(2.0)
label cycle(720.0 * units.deg)
label vee(90.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// 1964_Cadillac_VVI.pdf @ 0.001
// 316.0 332.0 LSA 113.50 ADV -10.50 OVL 97.0
label IVL(10.8458) // .427
label EVL(11.8364) // .466
label IVO(34.0 * units.deg) //BTDC
label IVC(102.0 * units.deg) //ABDC
label EVO(89.0 * units.deg) //BBDC
label EVC(63.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(566.99) // 20.0
label con_rod_mass(548.84677) // 19.36
label crank_mass(34.0) // ? kg
label flywheel_mass(8.0) // kg

label exhaust_delay_coeff(1.5)

public node eng_distributor {
    input wires;
    input timing_curve;
    input rev_limit: 10000 * units.rpm;
    input limiter_duration: 0.01;
    alias output __out:
        ignition_module(timing_curve: timing_curve, rev_limit: rev_limit, limiter_duration: limiter_duration)
            .connect_wire(wires.wire1, rot * 0)
            .connect_wire(wires.wire3, rot * 1)
            .connect_wire(wires.wire7, rot * 2)
            .connect_wire(wires.wire2, rot * 3)
            .connect_wire(wires.wire6, rot * 4)
            .connect_wire(wires.wire5, rot * 5)
            .connect_wire(wires.wire4, rot * 6)
            .connect_wire(wires.wire8, rot * 7);
}

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
}

