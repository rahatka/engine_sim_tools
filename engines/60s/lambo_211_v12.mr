import "engine_sim.mr"
import "../../fuel/50.mr"

units units()
constants constants()

label bore(77.0)
label stroke(62.0)
label compression_ratio(10.7)
label con_rod(119.0)
label compression_height(35.0 * units.mm) // ?
label intake_valve_diameter(42.0)
label exhaust_valve_diameter(38.2)
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(7500.0) // RPM

label cyl(12.0)
label cyl_base(cyl / row)
label row(2.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)
label rot_base(cycle / cyl_base)
label vee(60.0 * units.deg)

// 3.5
label IVL(9.5)
label EVL(8.4)
label IVO(45.0 * units.deg) //BTDC
label IVC(63.0 * units.deg) //ABDC
label EVO(58.0 * units.deg) //BBDC
label EVC(38.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(380.0) // ? g
label piston_mass(350.0) // ?
label crank_mass(18.0) // ?
label flywheel_mass(5.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

