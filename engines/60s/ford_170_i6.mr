import "engine_sim.mr"
import "../../fuel/50.mr"

units units()
constants constants()

label bore(88.9) // 3 1/2
label stroke(74.676) // 2.94
label compression_ratio(8.7)
label con_rod(119.761) // 4.715
label compression_height(40.132 * units.mm) // 1.58
label intake_valve_diameter(38.6588) // 1.522
label exhaust_valve_diameter(32.1564) // 1.266
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)

label redline(4700.0) // RPM

// Ford 170
label IVL(8.8392) // .348
label EVL(8.8392) // .348
label IVO(9.0 * units.deg) //BTDC
label IVC(51.0 * units.deg) //ABDC
label EVO(42.0 * units.deg) //BBDC
label EVC(18.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(500.0) // ?
label con_rod_mass(500.0) // ?
label crank_mass(19.0) // ? kg
label flywheel_mass(5.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

