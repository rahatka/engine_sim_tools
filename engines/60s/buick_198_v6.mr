import "engine_sim.mr"
import "../../fuel/50.mr"

units units()
constants constants()

label bore(92.075) // 3 5/8
label stroke(81.28) // 3 1/5
label compression_ratio(8.8)
label con_rod(151.384) // 5.960
label compression_height(46.99 * units.mm) // 1.85
label intake_valve_diameter(41.275) // 1 5/8
label exhaust_valve_diameter(34.925) // 1 3/8
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(6.0)
label row(2.0)
label cycle(720.0 * units.deg)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label vee(90.0 * units.deg)

label redline(5000.0) // RPM

// 1965 225 Base
label IVL(9.9314) // .391
label EVL(10.1854) // .401
label IVO(31.0 * units.deg) //BTDC
label IVC(74.0 * units.deg) //ABDC
label EVO(79.0 * units.deg) //BBDC
label EVC(36.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(700.0) // ? g
label piston_mass(700.0) // ?
label crank_mass(20.0) // ? kg
label flywheel_mass(6.0) // kg

label exhaust_delay_coeff(1.5)

// standard
public node variant_0 {
    output s1: 0;
    output s3: 1;
    output s2: 2;
}

