import "engine_sim.mr"
import "../../fuel/50.mr"

units units()
constants constants()

label bore(86.36) // 3 2/5
label stroke(104.775) // 4 1/8
label compression_ratio(8.4)
label con_rod(170.1546) // 6.699
label compression_height(44.196 * units.mm) // 1.74
label intake_valve_diameter(41.148) // 1.62 ; .372
label exhaust_valve_diameter(34.544) // 1.36 ; .372
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)

label redline(4700.0) // RPM

// 240/236 16 OVL
label IVL(10.033) // .395
label EVL(9.271) // .365
label IVO(10.0 * units.deg) //BTDC
label IVC(50.0 * units.deg) //ABDC
label EVO(50.0 * units.deg) //BBDC
label EVC(6.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(700.0) // ?
label con_rod_mass(500.0) // ?
label crank_mass(19.0) // ? kg
label flywheel_mass(5.0) // kg

label exhaust_delay_coeff(1.5)

label slant(30.0 * units.deg)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

