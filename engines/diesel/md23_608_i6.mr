import "engine_sim.mr"
import "../../fuel/diesel.mr"

units units()
constants constants()

label bore(115.0)
label stroke(160.0)
label compression_ratio(16.5)
label con_rod(288.0) // ~ 1.8 ratio, 0.9 specified in "За Рулём 1939 №5"
label compression_height(75.0 * units.mm) // ~
label intake_valve_diameter(50.0) // ~
label exhaust_valve_diameter(50.0) // ~
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(2000.0)

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// MD-23 timing
label IVL(10.0) // ?
label EVL(10.0) // ?
label IVO(5.0 * units.deg) //BTDC
label IVC(35.0 * units.deg) //ABDC
label EVO(50.0 * units.deg) //BBDC
label EVC(15.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(1500.0) // ?
label con_rod_mass(1800.0) // ?
label crank_mass(50.0) // ?
label flywheel_mass(9.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s4: 1;
    output s2: 2;
    output s6: 3;
    output s3: 4;
    output s5: 5;
}

