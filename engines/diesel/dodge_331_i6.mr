import "engine_sim.mr"
import "../../fuel/diesel.mr"

units units()
constants constants()

label bore(95.25) // 3 3/4
label stroke(127.0) // 5
label compression_ratio(14.75)
label con_rod(265.1125) // 10 7/16
label compression_height(139.7 / 2 * units.mm) // 5.5 l
label intake_valve_diameter(44.45) // 1 3/4 ? / 1 35/64 c
label exhaust_valve_diameter(38.1) // 1 1/2 ? / 1 5/16 c
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(2800.0)

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// Dodge 331 only lifts
label IVL(9.525) // .375
label EVL(9.525) // .375
label IVO(10.0 * units.deg) //BTDC
label IVC(46.0 * units.deg) //ABDC
label EVO(56.0 * units.deg) //BBDC
label EVC(10.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(1419.744) // 3.13
label con_rod_mass(1478.711) // 3.26
label crank_mass(50.0) // ?
label flywheel_mass(3.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

