import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(79.375) // 3 1/8
label stroke(101.6) // 4
label compression_ratio(5.7)
label con_rod(234.95) // 9 1/4
label compression_height(40.0 * units.mm)  // ~
label intake_valve_diameter(38.354) // 1932 1.446 ; 1934 1.510
label exhaust_valve_diameter(35.2298) // 1.452 ; 1934 1.387
label intake_valves(1.0)
label exhaust_valves(1.0)

label cyl(8.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)

label redline(3750.0) // RPM

// Cadillac 452 V16 valve timings
label IVL(8.73125) // 11/32
label EVL(8.73125) // 11/32
label IVO(0.0 * units.deg) //BTDC
label IVC(44.0 * units.deg) //ABDC
label EVO(39.0 * units.deg) //BBDC
label EVC(5.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label piston_mass(700.0)
label con_rod_mass(800.0)
label crank_mass(22.0) // ? kg
label flywheel_mass(7.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s2: 2;
    output s6: 3;
    output s8: 4;
    output s4: 5;
    output s7: 6;
    output s3: 7;
}

