import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(55.959375) // 2 13/64
label stroke(50.8) // 2
label compression_ratio(5.5)
label con_rod(101.6)
label compression_height(bore / 2 * units.mm)
label intake_valve_diameter(28.575) // 1 1/8
label exhaust_valve_diameter(25.4) // 1
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(5000.0) // RPM

label cyl(12.0)
label row(2.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)
label vee(60.0 * units.deg)

label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)

label IVL(6.35) // 1/4
label EVL(6.35) // 1/4
label IVO(11.0 * units.deg) //BTDC
label IVC(35.0 * units.deg) //ABDC
label EVO(41.0 * units.deg) //BBDC
label EVC(5.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(300.0)
label piston_mass(300.0)
label crank_mass(10.0)
label flywheel_mass(5.0)

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

public node variant_1 {
    output s1: 0;
    output s2: 1;
    output s4: 2;
    output s6: 3;
    output s5: 4;
    output s3: 5;
}

