import "engine_sim.mr"
import "../../fuel/10.mr"

units units()
constants constants()

label bore(139.7) // 5 1/2
label stroke(130.175) // 5 1/8
label compression_ratio(5.8)
label con_rod(247.3325) // 9.7375 (247.3325) ; 9 (228.6) Lion VIIa appendix ; 9.827 (249.6) Lion XIa
label L1(188.8)
label R1(61.1) // Lion XIa
label psi(80.0 * units.deg)
label compression_height(41.0 * units.mm)
label intake_valve_diameter(44.45) // ~ 1 3/4, 1.5 clear
label exhaust_valve_diameter(45.2437) // ~ 1 25/32 1.524 clear
label intake_valves(2.0)
label exhaust_valves(2.0)

label redline(2200.0) // RPM

label cyl(9.0)
label row(3.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label vee(rot)

// Napier Lion (@0.020")
label IVL(8.7376) // .344
label EVL(8.9916) // .354
label IVO(10.0 * units.deg) //BTDC
label IVC(51.25 * units.deg) //ABDC
label EVO(48.0 * units.deg) //BBDC
label EVC(10.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(4250.0)
label slave_rod_mass(600)
label piston_mass(1640.0)
label crank_mass(50.0) // ? kg
label flywheel_mass(20.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s2: 1;
    output s3: 2;
}

