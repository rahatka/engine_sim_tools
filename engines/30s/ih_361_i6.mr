import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(104.775) // 4 1/8
label stroke(114.3) // 4 1/2
label compression_ratio(5.2)
label con_rod(228.6) // 9
label compression_height(124.46 / 2 * units.mm) // 4.9 l
label intake_valve_diameter(57.15) // 2 1/4 ; .372 stem
label exhaust_valve_diameter(41.275) // 1 5/8 ; .372 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(3000.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// 361
label IVL(10.31875) // 13/32
label EVL(10.31875) // 13/32
label IVO(5.0 * units.deg) //BTDC
label IVC(45.0 * units.deg) //ABDC
label EVO(40.0 * units.deg) //BBDC
label EVC(10.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(1406.136) // 49.6
label piston_mass(1210.525) // 42.7
label crank_mass(30.0) // ?
label flywheel_mass(4.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

