import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(76.2) // 3
label stroke(101.6) // 4
label compression_ratio(5.8)
label con_rod(177.8) // 7
label compression_height(92.4719 / 2 * units.mm) // 3 41/64 l
label intake_valve_diameter(38.4969) // 1 33/64
label exhaust_valve_diameter(30.5594) // 1 13/64
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(3800.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// 1935 GP
label IVL(7.14375) // 9/32
label EVL(7.14375) // 9/32
label IVO(2.0 * units.deg) //BTDC
label IVC(42.0 * units.deg) //ABDC
label EVO(42.0 * units.deg) //BBDC
label EVC(8.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(700.0) // ?
label piston_mass(445.0875) // ?
label crank_mass(20.0) // ?
label flywheel_mass(4.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

