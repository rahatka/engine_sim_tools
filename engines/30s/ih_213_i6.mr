import "engine_sim.mr"
import "../../fuel/30.mr"

units units()
constants constants()

label bore(84.1375) // 3 5/16
label stroke(104.775) // 4 1/8
label compression_ratio(6.3)
label con_rod(209.55) // 8 1/4
label compression_height(99.822 / 2 * units.mm) // 3.93 l
label intake_valve_diameter(42.8625) // 1 11/16 ; .372 stem
label exhaust_valve_diameter(37.30625) // 1 15/32 ; .371 stem
label intake_valves(1.0)
label exhaust_valves(1.0)

label redline(3600.0) // RPM

label cyl(6.0)
label row(1.0)
label cycle(720.0 * units.deg)
label rot(cycle / cyl)
label cyl_base(cyl / row)
label rot_base(cycle / cyl_base)
label rot90(90.0 * units.deg)
label rot180(180.0 * units.deg)
label rot360(360.0 * units.deg)

// HD-213
label IVL(8.128) // .320
label EVL(8.128) // .320
label IVO(0.0 * units.deg) //BTDC
label IVC(38.0 * units.deg) //ABDC
label EVO(34.0 * units.deg) //BBDC
label EVC(4.0 * units.deg) //ATDC

label intake_duration(IVO + IVC + rot180)
label exhaust_duration(EVO + EVC + rot180)

label ILC((rot180 - IVO + IVC) / 2.0 + rot360)
label ELC((rot180 - EVO + EVC) / 2.0 + rot180)

label con_rod_mass(972.3886) // 34.3
label piston_mass(884.5051) // 31.2
label crank_mass(20.0) // ?
label flywheel_mass(4.0) // kg

label exhaust_delay_coeff(1.5)

public node variant_0 {
    output s1: 0;
    output s5: 1;
    output s3: 2;
    output s6: 3;
    output s2: 4;
    output s4: 5;
}

