import "engine_sim.mr"
units units()

public node s70 { // 70s standard
    alias output __out: f;
    fuel f(
        max_turbulence_effect: 9.0,
        burning_efficiency_randomness: 0.07,
        max_burning_efficiency: 0.76,
        molecular_mass: 85.0 * units.g,
        energy_density: 43.8 * units.MJ / units.kg,
        density: 0.742 * units.kg / units.L,
        molecular_afr: 14.6,
        low_efficiency_attenuation: 0.6,
        max_dilution_effect: 4.5,
        turbulence_to_flame_speed_ratio:
        function(5.0) // steepness 0.83
            .add_sample(0.0, 16.0)
            .add_sample(5.0, 28.6)
            .add_sample(10.0, 38.3)
            .add_sample(15.0, 47.3)
            .add_sample(20.0, 55.7)
            .add_sample(25.0, 63.8)
            .add_sample(30.0, 71.6)
            .add_sample(35.0, 79.2)
            .add_sample(40.0, 86.6)
            .add_sample(45.0, 93.9)
            .add_sample(50.0, 101.0)
            .add_sample(55.0, 108.0)
            .add_sample(60.0, 114.9)
            .add_sample(65.0, 121.7)
            .add_sample(70.0, 128.4)
            .add_sample(75.0, 135.0)
    )
}
