import "engine_sim.mr"
units units()

public node s50 { // 50s standard
    alias output __out: f;
    fuel f(
        max_turbulence_effect: 9.0,
        burning_efficiency_randomness: 0.07,
        max_burning_efficiency: 0.8,
        molecular_mass: 82.0 * units.g,
        energy_density: 46.3 * units.MJ / units.kg,
        density: 0.755 * units.kg / units.L,
        molecular_afr: 14.6,
        low_efficiency_attenuation: 0.7,
        max_dilution_effect: 4.5,
        turbulence_to_flame_speed_ratio:
        function(5.0) // steepness 0.9
            .add_sample(0.0, 17.0)
            .add_sample(5.0, 30.8)
            .add_sample(10.0, 42.8)
            .add_sample(15.0, 54.1)
            .add_sample(20.0, 65.1)
            .add_sample(25.0, 75.8)
            .add_sample(30.0, 86.3)
            .add_sample(35.0, 96.6)
            .add_sample(40.0, 106.7)
            .add_sample(45.0, 116.8)
            .add_sample(50.0, 126.7)
            .add_sample(55.0, 136.5)
            .add_sample(60.0, 146.3)
            .add_sample(65.0, 155.9)
            .add_sample(70.0, 165.5)
            .add_sample(75.0, 175.0)
    )
}
